# Copy to .env for local Compose use. All values below are local placeholders.
POSTGRES_PASSWORD=replace-with-a-local-development-password
ADMIN_TOKEN=replace-with-a-long-random-local-admin-token
ADMISSION_SIGNING_KEY=replace-with-at-least-32-bytes-of-random-local-key
ADMISSION_SIGNING_KEY_ID=admission-v1
PSP_WEBHOOK_SECRET=replace-with-at-least-32-bytes-of-random-webhook-secret
HOME_REGION=local-region
REGION_WRITER_ID=local-region-primary
LEASE_EPOCH=1
LEASE_DURATION_SECONDS=30
PSP_RATE_PER_SECOND=1400
PSP_BURST=50
PSP_MAX_CONCURRENT=64

# Optional k6 Compose profile
K6_PROFILE=spike
K6_TARGET_RPS=1750
K6_BASE_URL=http://flashsale:8080
ITEM_ID=flash-sale-demo
